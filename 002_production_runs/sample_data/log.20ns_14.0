
# randomize seeds
python get_random_integer return v_random_integer format i here """
def get_random_integer():
  import random
  # limits from random_mars.cpp
  return random.randint(1, 900000000)
"""
variable random_integer python get_random_integer

units      real
atom_style molecular
boundary   p p fs

# constants
variable atm  index 101325 #Pa
variable kcal index 4184 #J
variable N_A  index 6.022140857e+23
variable pi   index 3.141592653589793

# control temperature
variable temp index 85
# control pressure
variable press index 1e6 #Pa
variable tdamp index 100

variable dt    index 1
variable nstep index 20000000
variable tstep index 1000
variable dstep index 200000

bond_style harmonic
pair_style lj/smooth/linear 12
special_bonds lj 0 0 0

read_data data.eta0.2_per20_14.0
Reading data file ...
  orthogonal box = (0 0 0) to (39.173716 39.173716 82.570771)
  4 by 4 by 7 MPI processor grid
  reading atoms ...
  3601 atoms
  reading velocities ...
  3601 velocities
  scanning bonds ...
  9 = max bonds/atom
  orthogonal box = (0 0 0) to (39.173716 39.173716 82.579028)
  4 by 4 by 7 MPI processor grid
  reading bonds ...
  8208 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
    12 = max # of 1-2 neighbors
   132 = max # of 1-3 neighbors
  1584 = max # of 1-4 neighbors
   146 = max # of special neighbors
  special bonds CPU = 0.070 seconds
  read_data CPU = 0.169 seconds

group solid   type 1
1600 atoms in group solid
group fluid   type 2
2000 atoms in group fluid
group virtual type 3
1 atoms in group virtual
# fluid molecules interacting with the wall
group fluid_int id 1601:3200
1600 atoms in group fluid_int

variable eta index 0.2

# parameters for pair interactions and bonds
variable r0_ss   index 2.77
variable ndens   index $(1/v_r0_ss^2)
variable ndens   index 0.13032881961188078068
variable k_ss    index 67.36 #46.8 N/m

variable sig_ff  index 3.40  #0.340 nm
variable sig_ss  index 3.50  #0.350 nm
variable sig_fs  index $(0.5*(v_sig_ff+v_sig_ss))
variable sig_fs  index 3.4500000000000001776
variable sig_fw  index ${sig_fs}
variable sig_fw  index 3.4500000000000001776
variable eps_ff  index 0.240 #1.67x10^-21 J
variable eps_ss  index 0.144 #1.000x10^-21 J
variable eps0_fs index $(sqrt(v_eps_ff*v_eps_ss))
variable eps0_fs index 0.18590320061795598261
variable eps_fs  index $(v_eta*v_eps0_fs)
variable eps_fs  index 0.037180640123591200685
variable eps_fw  index $(2*v_pi/3*v_ndens*v_sig_fw^3*v_eps0_fs)
variable eps_fw  index 2.08373855579832723
variable rc_ff   index $(3.5*v_sig_ff)
variable rc_ff   index 11.900000000000000355
variable rc_ss   index ${r0_ss}
variable rc_ss   index 2.77
variable rc_fs   index $(3.5*v_sig_fs)
variable rc_fs   index 12.075000000000001066

# solid-solid
pair_coeff 1 1 0 0
# fluid-solid
pair_coeff 1 2 ${eps_fs} ${sig_fs} ${rc_fs}
pair_coeff 1 2 0.037180640123591200685 ${sig_fs} ${rc_fs}
pair_coeff 1 2 0.037180640123591200685 3.4500000000000001776 ${rc_fs}
pair_coeff 1 2 0.037180640123591200685 3.4500000000000001776 12.075000000000001066
# fluid-fluid
pair_coeff 2 2 ${eps_ff} ${sig_ff} ${rc_ff}
pair_coeff 2 2 0.240 ${sig_ff} ${rc_ff}
pair_coeff 2 2 0.240 3.40 ${rc_ff}
pair_coeff 2 2 0.240 3.40 11.900000000000000355
# virtual particle
pair_coeff 3 * 0 0

# phantom wall position
variable pos_pwall index 14.0

# couple lj wall with virtual particle
# virtual particle is the last atom
variable z_virtual  equal z[3601]
# upper lj wall only interacts with fluid atoms
fix uwall fluid wall/lj93 zhi v_z_virtual ${eps_fw} ${sig_fw} $(3.5*v_sig_fw)
fix uwall fluid wall/lj93 zhi v_z_virtual 2.08373855579832723 ${sig_fw} $(3.5*v_sig_fw)
fix uwall fluid wall/lj93 zhi v_z_virtual 2.08373855579832723 3.4500000000000001776 $(3.5*v_sig_fw)
fix uwall fluid wall/lj93 zhi v_z_virtual 2.08373855579832723 3.4500000000000001776 12.075000000000001066
# phantom wall interacts only with fluid in group int (repulsive)
fix pwall fluid_int wall/lj93 zlo ${pos_pwall} ${eps_fw} ${sig_fw} $(v_sig_fw*(2/5)^(1/6))
fix pwall fluid_int wall/lj93 zlo 14.0 ${eps_fw} ${sig_fw} $(v_sig_fw*(2/5)^(1/6))
fix pwall fluid_int wall/lj93 zlo 14.0 2.08373855579832723 ${sig_fw} $(v_sig_fw*(2/5)^(1/6))
fix pwall fluid_int wall/lj93 zlo 14.0 2.08373855579832723 3.4500000000000001776 $(v_sig_fw*(2/5)^(1/6))
fix pwall fluid_int wall/lj93 zlo 14.0 2.08373855579832723 3.4500000000000001776 2.9613910553173221629

variable A index $(lx*ly)
variable A index 1534.5800000000001546
# kcal/mol -> J                  kcal->J       1/mol->1
variable ene_real2si         index $(v_kcal/v_N_A)
variable ene_real2si         index 6.9476953451472541725e-21
# kcal/mol -> J/m^2              kcal/mol->J   1->1/A^2 1/A^2->1/m^2
variable ene2edens_real2si   index $(v_ene_real2si/v_A*1e20)
variable ene2edens_real2si   index 0.00045274246667800007327
# kcal/mol/A -> N                kcal/mol->J   1/A->1/m
variable force_real2si       index $(v_ene_real2si*1e10)
variable force_real2si       index 6.9476953451472536082e-11
# kcal/mol/A -> Pa               kcal/mol/A->N 1->1/A 1/A->m
variable force2press_real2si index $(v_force_real2si/v_A*1e20)
variable force2press_real2si index 4527424.6667800005525

# pressure control via virtual atom
variable force index $(v_press/v_force2press_real2si)
variable force index 0.22087612132731984649

# the force on virtual atom is force on lj wall + control force(z minus derection)
variable virtual_force equal f_uwall[1]-v_force
fix set_virtual_force virtual setforce 0 0 v_virtual_force

# find first bottom layer and fix it
region first_bottom plane 0 0 $(bound(solid,zmin)+0.5) 0 0 -1
region first_bottom plane 0 0 2.4586857838867075543 0 0 -1
group first_bottom region first_bottom
200 atoms in group first_bottom

# find second bottom layer and control temperature
region second_bottom plane 0 0 $(bound(solid,zmin)+2.5) 0 0 -1
region second_bottom plane 0 0 4.4586857838867075543 0 0 -1
group second_bottom region second_bottom
400 atoms in group second_bottom
print "N=$(count(second_bottom))"
N=400
group second_bottom subtract second_bottom first_bottom
200 atoms in group second_bottom
print "N=$(count(second_bottom))"
N=200

# heat bath for second bottom layer
fix second_bottom second_bottom langevin ${temp} ${temp} ${tdamp} ${random_integer}
fix second_bottom second_bottom langevin 85 ${temp} ${tdamp} ${random_integer}
fix second_bottom second_bottom langevin 85 85 ${tdamp} ${random_integer}
fix second_bottom second_bottom langevin 85 85 100 ${random_integer}
fix second_bottom second_bottom langevin 85 85 100 404905367

# set top heat bath layer
variable is_hbath atom z>$(v_z_virtual-20)
variable is_hbath atom z>62.562585074871194024
group hbath_atoms dynamic fluid var is_hbath every 1
dynamic group hbath_atoms defined
fix hbath hbath_atoms langevin ${temp} ${temp} ${tdamp} ${random_integer}
fix hbath hbath_atoms langevin 85 ${temp} ${tdamp} ${random_integer}
fix hbath hbath_atoms langevin 85 85 ${tdamp} ${random_integer}
fix hbath hbath_atoms langevin 85 85 100 ${random_integer}
fix hbath hbath_atoms langevin 85 85 100 413351548

# integrate solid atoms except first_bottom
group integ subtract all first_bottom
3401 atoms in group integ
fix integ integ nve
fix balance all balance 100 1.0 shift z 10 1.1

# density distribution
compute chunk_bin fluid chunk/atom bin/1d z lower 0.1 nchunk every ids every compress no discard no units box
fix fluid_1D fluid ave/chunk 1 $(v_nstep/20) $(v_nstep/20) chunk_bin temp density/mass file fluid_20ns_14.0.dat format " %.17e" norm all ave one
fix fluid_1D fluid ave/chunk 1 1000000 $(v_nstep/20) chunk_bin temp density/mass file fluid_20ns_14.0.dat format " %.17e" norm all ave one
fix fluid_1D fluid ave/chunk 1 1000000 1000000 chunk_bin temp density/mass file fluid_20ns_14.0.dat format " %.17e" norm all ave one
fix fluid_int_1D fluid_int ave/chunk 1 $(v_nstep/20) $(v_nstep/20) chunk_bin temp density/mass file fluid_int_20ns_14.0.dat format " %.17e" norm all ave one
fix fluid_int_1D fluid_int ave/chunk 1 1000000 $(v_nstep/20) chunk_bin temp density/mass file fluid_int_20ns_14.0.dat format " %.17e" norm all ave one
fix fluid_int_1D fluid_int ave/chunk 1 1000000 1000000 chunk_bin temp density/mass file fluid_int_20ns_14.0.dat format " %.17e" norm all ave one

compute fgroup fluid group/group solid
variable press_fs    equal c_fgroup[3]*v_force2press_real2si
variable press_uwall equal f_uwall[1]*v_force2press_real2si
variable press_pwall equal f_pwall[1]*v_force2press_real2si

variable pe_pwall   equal f_pwall*v_ene2edens_real2si
compute pe_ff fluid pe/tally fluid
variable pe_ff      equal c_pe_ff*v_ene2edens_real2si
compute pe_fs       solid pe/tally fluid
variable pe_fs      equal c_pe_fs*v_ene2edens_real2si

# log output
thermo_style custom step temp pe ke etotal pzz v_z_virtual v_press_fs v_press_uwall v_press_pwall v_pe_pwall v_pe_ff v_pe_fs
thermo ${tstep}
thermo 1000

# traj output
dump traj all atom ${dstep} traj.20ns_14.0.lammpstrj
dump traj all atom 200000 traj.20ns_14.0.lammpstrj

timestep ${dt}
timestep 1

run ${nstep}
run 20000000

